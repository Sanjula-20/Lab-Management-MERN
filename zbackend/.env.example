# ==============================================================================
# Lab Management System - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' in zbackend/ and update values to match your local setup:
#   copy .env.example .env     (Windows CMD)
#   cp .env.example .env       (Linux / macOS / PowerShell)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# MySQL / MariaDB Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lab_management
DB_USER=root
DB_PASSWORD=

# Fallback alias variables for local database connection
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=3306
DB_PASS=

# Initial Administrator Seed Credentials (Used by npm run db:seed on fresh databases)
INITIAL_ADMIN_EMAIL=admin@labms.local
INITIAL_ADMIN_PASSWORD=Admin@123

# Client & CORS Configuration
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Authentication Security (Change in production)
JWT_SECRET=dev-labms-jwt-secret-key-change-in-production

# Google OAuth (Optional - leave blank if not using Google Sign-In locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Configuration (Optional - for password resets & notifications)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# AI Chatbot Integration (Optional - for Gemini assistant)
GEMINI_API_KEY=
